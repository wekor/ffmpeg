{
  "name": "@wekor/react-native-ffmpeg",
  "version": "9.0.0",
  "description": "FFmpeg and FFprobe for React Native.",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "*.podspec",
    "!ios/build",
    "!ios/Frameworks",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "bun run --cwd example",
    "check": "biome check",
    "fix": "biome check --write",
    "format": "biome format --write",
    "clean": "del-cli lib",
    "prepare": "bob build",
    "typecheck": "tsc && tsc -p example",
    "test": "bun test src",
    "build:android:prepare": "bun run example expo prebuild --platform android --no-install",
    "build:android": "./example/android/gradlew --project-dir example/android app:assembleDebug",
    "build:ios:prepare": "bun run example expo prebuild --platform ios",
    "build:ios": "xcodebuild -workspace example/ios/FFmpegExample.xcworkspace -scheme FFmpegExample -configuration Debug -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' CODE_SIGNING_ALLOWED=NO build -quiet"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "ffmpeg",
    "ffprobe",
    "ffmpeg-kit",
    "video",
    "audio"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wekor/ffmpeg.git",
    "directory": "react-native"
  },
  "author": "wekor",
  "license": "LGPL-3.0",
  "bugs": {
    "url": "https://github.com/wekor/ffmpeg/issues"
  },
  "homepage": "https://github.com/wekor/ffmpeg/tree/master/react-native#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@react-native/babel-preset": "0.88.0",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.2.0",
    "del-cli": "^8.0.1",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-builder-bob": "^0.44.1",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.80.0"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "bun@1.4.4",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "ReactNativeFFmpegSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.wekor.reactnativeffmpeg"
    }
  },
  "ffmpegKit": {
    "release": "native-v9.0.2",
    "iosSha256": ""
  }
}
